PB_BASE_URL="http://localhost:12312"

PB_SU_TOKEN=""

# Spigot stations (Pico W + RC522 at each tap) — see firmware/spigot/README.md.
# Shared secret the stations send as a bearer token; it also signs the kiosks' tickets
# to the spigot stream. Leave empty on a server without stations: the feature stays off.
SPIGOT_SECRET=""
# Folder where the venue server keeps what the stations need with no PocketBase in reach:
# which NFC tags are drinks, whose cards are whose, and their pictures for the station
# displays. Defaults to data/_spigots.
SPIGOT_CACHE_DIR=""
