{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "bar": {
      "type": "string",
      "minLength": 15,
      "maxLength": 15,
      "pattern": "^[a-z0-9]+$",
      "description": "ID of the bar this item belongs to"
    },
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 10,
      "pattern": "^[a-z0-9\\-]+$",
      "description": "Unique key identifier for the offer item within a bar"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the offer item"
    },
    "servingPreset": {
      "type": "string",
      "enum": ["tap", "unit"],
      "description": "Which set of portions the item is served in: 'tap' pours 0.3/0.5 l, 'unit' sells single pieces"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "Price per serving, keyed by the serving keys of servingPreset (e.g. {'0_3': 44, '0_5': 62})"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "servingPreset": { "const": "tap" } },
        "required": ["servingPreset"]
      },
      "then": {
        "properties": {
          "pricing": { "propertyNames": { "enum": ["0_3", "0_5"] } }
        }
      }
    },
    {
      "if": {
        "properties": { "servingPreset": { "const": "unit" } },
        "required": ["servingPreset"]
      },
      "then": {
        "properties": {
          "pricing": { "propertyNames": { "enum": ["1"] } }
        }
      }
    }
  ],
  "required": ["bar", "key", "name", "servingPreset"],
  "additionalProperties": false
}
