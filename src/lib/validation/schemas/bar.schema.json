{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "pattern": "^[a-z0-9\\-]+$",
      "description": "Unique slug identifier for the bar"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "description": "Display name of the bar"
    }
  },
  "required": ["slug", "name"],
  "additionalProperties": false
}
