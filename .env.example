PB_BASE_URL="http://localhost:12312"

PB_SU_TOKEN=""

# Read cards from a PC/SC reader on this machine and push them to kiosks over SSE.
#USE_CARD_SSE=

# How often (ms) to ask the reader's PN532 whether it is still polling. 0 disables
# the watchdog. The probe is a read-only PN532 GetFirmwareVersion sent as a CCID
# escape command, so on Linux it needs `ifdDriverOptions = 0x0001` in libccid's
# Info.plist; without that the first probe is refused and probing switches itself
# off (see the server log) rather than resetting a working reader.
#CARD_READER_PROBE_MS=60000

# Shell command that re-plugs the reader, run when the watchdog decides it has
# stopped polling and when staff press "Re-plug reader". An ACR122U-class device
# needs a real USB re-enumeration to come back, which needs privileges this
# process should not hold — so the command is yours to supply and to authorise
# (sudoers, a setuid helper, a smart hub). Examples:
#   usbreset 072f:2200
#   uhubctl -a cycle -l 1-1 -p 2
#CARD_READER_RESET_CMD=
